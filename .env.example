# Required runtime configuration
DATABASE_URL=
GITHUB_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Product Hunt API v2 developer token (https://www.producthunt.com/v2/oauth/applications).
